FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker

# Install systemd + SSH + packages with CIS violations
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd \
    systemd-sysv \
    openssh-server \
    python3 \
    python3-apt \
    sudo \
    iproute2 \
    procps \
    ufw \
    cron \
    at \
    telnet \
    xinetd \
    lynis \
    && rm -rf /var/lib/apt/lists/*

# Mask unnecessary systemd units
RUN systemctl mask \
    dev-hugepages.mount \
    sys-fs-fuse-connections.mount \
    systemd-udev-trigger.service \
    systemd-udevd.service \
    systemd-update-utmp.service \
    systemd-logind.service \
    getty@.service \
    getty.target

RUN systemctl enable ssh
RUN systemctl enable cron

# SSH misconfigurations (CIS 5.2.x)
RUN mkdir -p /run/sshd \
    && sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/#PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/#MaxAuthTries.*/MaxAuthTries 6/' /etc/ssh/sshd_config \
    && sed -i 's/#LoginGraceTime.*/LoginGraceTime 120/' /etc/ssh/sshd_config \
    && sed -i 's/#ClientAliveInterval.*/ClientAliveInterval 0/' /etc/ssh/sshd_config \
    && sed -i 's/#ClientAliveCountMax.*/ClientAliveCountMax 3/' /etc/ssh/sshd_config

# File permissions too open (CIS 6.1.x)
RUN chmod 0644 /etc/shadow \
    && chmod 0644 /etc/gshadow

# Core dumps not restricted (CIS 1.5.x)
RUN echo '* soft core unlimited' > /etc/security/limits.d/core.conf

# Sysctl not hardened (CIS 3.x)
RUN echo 'net.ipv4.ip_forward = 1' > /etc/sysctl.d/99-insecure.conf \
    && echo 'net.ipv4.conf.all.accept_redirects = 1' >> /etc/sysctl.d/99-insecure.conf \
    && echo 'net.ipv4.conf.all.send_redirects = 1' >> /etc/sysctl.d/99-insecure.conf

# No login banner (CIS 1.7.x)
RUN rm -f /etc/motd && rm -f /etc/issue.net

# Cron/at — no access restrictions (CIS 5.1.x)
RUN rm -f /etc/cron.allow \
    && rm -f /etc/at.allow

# Dread Admiral Snowflake's planted credentials
RUN echo -e "# Fleet Database Credentials — DO NOT SHARE\nfleet_db_user: admin\nfleet_db_pass: V01dborn_Hunter_2187\nfleet_api_key: sk-sdc-1a2b3c4d5e6f7g8h9i0j" > /opt/fleet-db-creds.txt

# Create cadet user
RUN useradd -m -s /bin/bash cadet \
    && echo 'cadet:academy' | chpasswd \
    && echo 'cadet ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers.d/cadet \
    && chmod 0440 /etc/sudoers.d/cadet

RUN mkdir -p /home/cadet/.ssh \
    && chmod 700 /home/cadet/.ssh \
    && chown cadet:cadet /home/cadet/.ssh

RUN echo 'root:starfall' | chpasswd

EXPOSE 22
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
